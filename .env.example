# Copy to .env (`npm run ensure-env` does this automatically) and adjust.
# No real secrets belong in this file — it is committed.

# SQLite database. Relative `file:` paths are resolved against prisma/,
# so this points at prisma/dev.db. The test suite overrides this with
# file:./test.db (prisma/test.db).
DATABASE_URL="file:./dev.db"

# Secret used to sign the `session` JWT cookie (HS256).
# Generate a real one for anything non-local: `openssl rand -base64 48`
SESSION_SECRET="dev-only-insecure-session-secret-change-me-0123456789"

# Where LocalDiskAdapter writes uploads. Must live under ./public to be served.
UPLOAD_DIR="./public/uploads"
