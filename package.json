{
  "name": "quill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ensure-env": "node prisma/ensure-env.mjs",
    "dev": "npm run ensure-env && next dev",
    "build": "npm run ensure-env && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "npm run ensure-env && prisma generate",
    "db:migrate": "npm run ensure-env && prisma migrate deploy && prisma generate",
    "db:migrate:dev": "npm run ensure-env && prisma migrate dev",
    "db:reset": "npm run ensure-env && prisma migrate reset --force --skip-seed && npm run db:seed",
    "db:seed": "npm run ensure-env && tsx prisma/seed.ts",
    "test": "npm run ensure-env && vitest run",
    "test:watch": "npm run ensure-env && vitest",
    "test:e2e": "playwright test",
    "postinstall": "node prisma/ensure-env.mjs && prisma generate"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@prisma/client": "^6.5.0",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "^15.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.3",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  }
}
